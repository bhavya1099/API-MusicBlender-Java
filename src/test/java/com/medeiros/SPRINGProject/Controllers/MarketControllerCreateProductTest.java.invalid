package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.LogModel;
import com.medeiros.SPRINGProject.Models.ProductModel;
import com.medeiros.SPRINGProject.Models.ProductModelRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import org.mockito.Mockito;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.web.server.ResponseStatusException;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.Models.LogRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@SpringBootTest
public class MarketControllerCreateProductTest {
    @MockBean
    private ProductModelRepository ProductRepository;
    @Test
    @Tag("valid")
    public void testCreateValidProduct() {
        MarketController mc = new MarketController(ProductRepository);
        String result = mc.createProduct("guitar", 1000.0, 1, 1, "Musical Instruments");
        Assertions.assertEquals("Produto Criado", result);
    }
    @Test
    @Tag("invalid")
    public void testCreateProductWithNegativePrice() {
        MarketController mc = new MarketController(ProductRepository);
        // We expect a ResponseStatusException when price is negative.
        Exception exception = Assertions.assertThrows(ResponseStatusException.class,
            () -> mc.createProduct("guitar", -1000.0, 1, 1, "Musical Instruments"));
        Assertions.assertTrue(exception.getMessage().contains("Price cannot be negative"));
    }
    @Test
    @Tag("boundary")
    public void testCreateProductWithEmptyDescription() {
        MarketController mc = new MarketController(ProductRepository);
        // We expect a ResponseStatusException when description is empty.
        Exception exception = Assertions.assertThrows(ResponseStatusException.class,
            () -> mc.createProduct("", 1000.0, 1, 1, "Musical Instruments"));
        Assertions.assertTrue(exception.getMessage().contains("Description cannot be empty"));
    }
}   