package com.medeiros.SPRINGProject.Controllers;import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.algorithm.algorithmBlender;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.util.Map;

public class AppControllerLikeMusicByIdTest {
    MusicRepository musicRepoMock = Mockito.mock(MusicRepository.class);
    LogRepository logMock = Mockito.mock(LogRepository.class);
    AppController controller;
    @BeforeEach
     void setUp() {
        controller = new AppController(musicRepoMock, logMock);
    }
    @Test
    @Tag("valid")
    public void testIncreaseInLikes() {
        MusicModel mockMusic = new MusicModel();
        mockMusic.setNumberOfLikes(0);
        when(musicRepoMock.findById(anyInt())).thenReturn(java.util.Optional.ofNullable(mockMusic));
        String result = controller.LikeMusicById(1);
        assertEquals(1, mockMusic.getNumberOfLikes());
        assertEquals("Música Alterada!", result);
    }
    @Test
    @Tag("integration")
    public void testCorrectSavingOfLogModel() {
        MusicModel mockMusic = new MusicModel();
        when(musicRepoMock.findById(anyInt())).thenReturn(java.util.Optional.ofNullable(mockMusic));
        controller.LikeMusicById(1);
        verify(logMock, times(1)).save(any(LogModel.class));
    }
    @Test
    @Tag("invalid")
    public void testWhenMusicNotFound() {
        when(musicRepoMock.findById(anyInt())).thenReturn(java.util.Optional.empty());
        assertThrows(RuntimeException.class, () -> {
            controller.LikeMusicById(1);
        });
    }
    @Test
    @Tag("valid")
    public void testLikeOnAlreadyLikedMusic() {
        MusicModel mockMusic = new MusicModel();
        mockMusic.setNumberOfLikes(0);
        when(musicRepoMock.findById(anyInt())).thenReturn(java.util.Optional.ofNullable(mockMusic));
        controller.LikeMusicById(1);
        controller.LikeMusicById(1);
        assertEquals(2, mockMusic.getNumberOfLikes());
    }
}