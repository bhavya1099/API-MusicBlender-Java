package com.medeiros.SPRINGProject.Controllers;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.beans.factory.annotation.Autowired;
import com.medeiros.SPRINGProject.Models.LogModel;
import com.medeiros.SPRINGProject.Models.LogRepository;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import java.util.Arrays;
import java.util.List;
import java.util.ArrayList;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@ExtendWith(MockitoExtension.class)
class LogControllerShowAllLogTest {
	
	@Autowired
	LogController logController;
	LogRepository logRepository;
	@BeforeEach
	void init() {
		logRepository = Mockito.mock(LogRepository.class);
		logController = new LogController(logRepository);
	}
	@Test
	void validateReturnOfAllLogs(){
		List<LogModel> logs = Arrays.asList(new LogModel(), new LogModel());
		when(logRepository.findAll()).thenReturn(logs);
		Iterable<LogModel> returnedLogs = logController.showAllLog();
		assertTrue(returnedLogs.spliterator().getExactSizeIfKnown() == logs.size());
	}
	@Test
	void handleEmptyLogRepository(){
		List<LogModel> logs = new ArrayList<>();
		when(logRepository.findAll()).thenReturn(logs);
		Iterable<LogModel> returnedLogs = logController.showAllLog();
		assertTrue(((List<LogModel>) returnedLogs).isEmpty());
	}
	@Test
	void verifyRetrievalOrderOfLogs(){
		List<LogModel> logs = Arrays.asList(new LogModel(1), new LogModel(2), new LogModel(3));
		when(logRepository.findAll()).thenReturn(logs);
		Iterable<LogModel> returnedLogs = logController.showAllLog();
		int index = 1;
                for(LogModel log : returnedLogs) {
                    assertEquals(index++, log.getId());
                }
	}
	@Test
	void validateReturnType(){
		when(logRepository.findAll()).thenReturn(Arrays.asList(new LogModel()));
		Iterable<LogModel> returnedLogs = logController.showAllLog();
		assertTrue(returnedLogs instanceof Iterable);
	}
	@Test
	void validateMethodCallToRepository(){
		logController.showAllLog();
		verify(logRepository, times(1)).findAll();
	}
}