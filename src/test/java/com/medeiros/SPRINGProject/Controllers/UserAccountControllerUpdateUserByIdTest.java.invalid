package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.time.LocalDateTime;
import java.util.Objects;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
public class UserAccountControllerUpdateUserByIdTest {
    @Mock
    private User_Account_Repository UserAccRepo;
    @InjectMocks
    private UserAccountController userAccountController;
    @Test
    @Tag("valid")
    void testSuccessfulUserUpdate() {
        User_Credentials userExist = new User_Credentials();
        when(UserAccRepo.findById(1)).thenReturn(userExist);
        String result = userAccountController.updateUserById("1", "test@gmail.com", "123", "testUsername");
        assertEquals("Usuário Salvo", result);
    }
    @Test
    @Tag("invalid")
    void testUnsuccessfulUserUpdateWithNonExistingId() {
        when(UserAccRepo.findById(1)).thenReturn(null);
        String result = userAccountController.updateUserById("1", "test@gmail.com", "123", "testUsername");
        assertEquals("User não encontrado", result);
    }
    @Test
    @Tag("boundary")
    void testHandleNullIDUpdate() {
        assertThrows(NumberFormatException.class, () -> {
            userAccountController.updateUserById(null, "test@gmail.com", "123", "testUsername");
        });
    }
    @Test
    @Tag("valid")
    void testUserUpdateWithEmptyFields() {
        User_Credentials userExist = new User_Credentials();
        when(UserAccRepo.findById(1)).thenReturn(userExist);
        String result = userAccountController.updateUserById("1", "", "", "");
        assertEquals("Usuário Salvo", result);
        assertTrue(userExist.getEmail().isEmpty());
        assertTrue(userExist.getPassword().isEmpty());
        assertTrue(userExist.getUsername().isEmpty());
    }
}