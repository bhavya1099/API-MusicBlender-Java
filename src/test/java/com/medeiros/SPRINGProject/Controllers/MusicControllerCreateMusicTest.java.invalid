package com.medeiros.SPRINGProject.Controllers;import com.medeiros.SPRINGProject.Models.MusicModel;
import com.medeiros.SPRINGProject.Models.MusicRepository;
import com.medeiros.SPRINGProject.Controllers.MusicController;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.junit.jupiter.SpringExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import com.medeiros.SPRINGProject.Models.LogModel;
import com.medeiros.SPRINGProject.Models.LogRepository;
import org.springframework.web.bind.annotation.*;

@ExtendWith(SpringExtension.class)
public class MusicControllerCreateMusicTest {
    @Autowired
    private MusicController musicController;
    @MockBean
    private MusicRepository MusicRepo;
    @BeforeEach
    void setUp() {
        musicController = new MusicController(); // Removed argument from MusicController
        // Assuming a setter method exists in MusicController to set the MusicRepo
        musicController.setMusicRepo(MusicRepo); 
    }
    @Test
    @Tag("Valid")
    void testCreateMusicWithValidData() {
        MusicModel newMusic = new MusicModel(1, "Song1", "SongData", "Description");
        when(MusicRepo.save(Mockito.any(MusicModel.class))).thenReturn(newMusic);
        String result = musicController.createMusic("Description", "Song1", "SongData", 1);
        assertEquals("Operação Feita", result);
    }
    @Test
    @Tag("Invalid")
    void testCreateMusicWithDuplicateData() {
        MusicModel newMusic = new MusicModel(1, "Song1", "SongData", "Description");
        when(MusicRepo.save(Mockito.any(MusicModel.class))).thenReturn(newMusic);
        
        assertEquals("Operação Feita", musicController.createMusic("Description", "Song1", "SongData", 1));
        assertEquals("Operação Feita", musicController.createMusic("Description", "Song1", "SongData", 1));
        
        verify(MusicRepo, times(2)).save(Mockito.any(MusicModel.class));
    }
    @Test
    @Tag("Boundary")
    void testCreateMusicWithNullData() {
        assertThrows(IllegalArgumentException.class, () -> musicController.createMusic(null, null, null, 0));
    }
    @Test
    @Tag("Boundary")
    void testCreateMusicWithInvalidUserId() {
        assertThrows(IllegalArgumentException.class, () -> musicController.createMusic("Description", "Song1", "SongData", -1));
    }
}