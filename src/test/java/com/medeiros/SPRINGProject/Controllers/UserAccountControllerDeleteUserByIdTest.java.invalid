@ExtendWith(MockitoExtension.class)
class UserAccountControllerDeleteUserByIdTest {
    @InjectMocks
    private UserAccountController userAccountController;
    @Mock
    private UserAccRepository userAccRepo;
    @Test
    @Tag("Valid")
    void testDeleteUserByIdWithValidId() {
        doNothing().when(userAccRepo).deleteById(anyInt());
        assertEquals("Conta Deletada", userAccountController.deleteUserById("1"));
    }
    @Test
    @Tag("Boundary")
    void testDeleteUserByIdWhenRepoIsEmpty() {
        doThrow(new RuntimeException()).when(userAccRepo).deleteById(anyInt());
        assertThrows(RuntimeException.class, () -> userAccountController.deleteUserById("1"));
    }
    @Test
    @Tag("Invalid")
    void testDeleteUserByIdWithInvalidId() {
        doThrow(new RuntimeException()).when(userAccRepo).deleteById(anyInt());
        assertThrows(RuntimeException.class, () -> userAccountController.deleteUserById("0"));
    }
    @Test
    @Tag("Invalid")
