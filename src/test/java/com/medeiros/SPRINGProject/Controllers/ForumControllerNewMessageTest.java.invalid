package com.medeiros.SPRINGProject.Controllers;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.*;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.boot.test.context.SpringBootTest;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@SpringBootTest
public class ForumControllerNewMessageTest {
    @Mock
    ChatRepository mockChatRepo;
    private ForumController forumController;
    @BeforeEach
    public void setup() {
        MockitoAnnotations.initMocks(this);
        forumController = new ForumController(mockChatRepo);
    }
    @Tag("valid")
    @Test
    public void testRegularMessageCreation() {
        int userId = 1;
        int forumId = 1;
        String message = "sample message";
        when(mockChatRepo.save(any(ForumChatModel.class))).thenReturn(new ForumChatModel());
        String returnedMessage = forumController.newMessage(message, userId, forumId);
        assertEquals(message, returnedMessage);
    }
    @Tag("invalid")
    @Test
    public void testNewMessageWithInvalidUserId() {
        int userId = -5;
        int forumId = 1;
        String message = "sample message";
        try {
            String returnedMessage = forumController.newMessage(message, userId, forumId);
            fail("Expected an IllegalArgumentException to be thrown");
        } catch (IllegalArgumentException e) {
            assertEquals("Invalid user ID.", e.getMessage());
        }
    }
    @Tag("invalid")
    @Test
    public void testNewMessageToNonExistentForum() {
        int userId = 1;
        int forumId = -1;
        String message = "sample message";
        when(mockChatRepo.save(any(ForumChatModel.class))).thenThrow(new IllegalArgumentException("Forum does not exist."));
        try {
            String returnedMessage = forumController.newMessage(message, userId, forumId);
            fail("Expected an IllegalArgumentException to be thrown");
        } catch (IllegalArgumentException e) {
            assertEquals("Forum does not exist.", e.getMessage());
        }
    }
    @Tag("invalid")
    @Test
    public void testNewMessageWithNullMessage() {
        int userId = 1;
        int forumId = 1;
        String message = null;
        try {
            String returnedMessage = forumController.newMessage(message, userId, forumId);
            fail("Expected an IllegalArgumentException to be thrown");
        } catch (IllegalArgumentException e) {
            assertEquals("Message cannot be null.", e.getMessage());
        }
    }
    @Tag("valid")
    @Test
    public void testNewMessageWithEmptyMessage() {
        int userId = 1;
        int forumId = 1;
        String message = "";
        when(mockChatRepo.save(any(ForumChatModel.class))).thenReturn(new ForumChatModel());
        String returnedMessage = forumController.newMessage(message, userId, forumId);
        assertEquals(message, returnedMessage);
    }
}