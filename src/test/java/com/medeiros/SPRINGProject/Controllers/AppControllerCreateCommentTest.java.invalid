package com.medeiros.SPRINGProject.Controllers;import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import com.medeiros.SPRINGProject.Models.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import com.medeiros.SPRINGProject.algorithm.algorithmBlender;
import java.util.Map;
import org.springframework.web.bind.annotation.*;

@SpringBootTest
public class AppControllerCreateCommentTest {
    AppController appController;
    @MockBean
    CommentsRepo mockCommentsRepo;
    @MockBean
    Log mockLog;
    @MockBean
    LogModel mockDate;
    @BeforeEach
    public void setUp() {
        appController = new AppController(mockCommentsRepo, mockLog, mockDate);
    }
    @Test
    @Tag("valid")
    public void verifyTheCreationOfNewComment() {
        int id = 1;
        String comment = "Lorem ipsum";
        CommentsModel expectedComment = new CommentsModel(comment, id);
        LogModel expectedLogData = new LogModel("app/createComment/{id}", "App", mockDate.getTimeNow());
        when(mockCommentsRepo.save(expectedComment)).thenReturn(expectedComment);
        when(mockLog.save(expectedLogData)).thenReturn(expectedLogData);
        String actual = appController.createComment(id, comment);
        verify(mockCommentsRepo, times(1)).save(expectedComment);
        verify(mockLog, times(1)).save(expectedLogData);
        assertEquals(comment, actual);
    }
    @Test
    @Tag("invalid")
    public void handleNullComments() {
        int id = 1;
        String comment = null;
        
        assertThrows(IllegalArgumentException.class, () -> {
            appController.createComment(id, comment);
        });
    }
    @Test
    @Tag("invalid")
    public void handleNegativeIdValues() {
        int id = -1;
        String comment = "Lorem ipsum";
        
        assertThrows(IllegalArgumentException.class, () -> {
            appController.createComment(id, comment);
        });
    }    
}